# Copy to .env. Project-prefixed names prevent accidental overlap with other repositories.
# The API process starts inside apps/api, so these paths resolve to this repository's storage.
SCHOLARSHIP_FINDER_DATABASE_URL=sqlite:///../../storage/database/scholarship_finder.db
SCHOLARSHIP_FINDER_DOCUMENT_STORAGE_PATH=../../storage/documents
SCHOLARSHIP_FINDER_API_HOST=127.0.0.1
SCHOLARSHIP_FINDER_API_PORT=8217
SCHOLARSHIP_FINDER_WEB_ORIGIN=http://127.0.0.1:3217
NEXT_PUBLIC_SCHOLARSHIP_FINDER_API_URL=http://127.0.0.1:8217
NEXT_TELEMETRY_DISABLED=1
# Optional comma-separated exact domains. Leave empty until you have reviewed a source.
SCHOLARSHIP_FINDER_TRUSTED_SOURCE_DOMAINS=
