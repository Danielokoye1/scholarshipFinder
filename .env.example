# Copy to .env. The defaults keep every service local to this machine.
# The API process starts inside apps/api, so these resolve to the repository storage directory.
DATABASE_URL=sqlite:///../../storage/database/scholarship_finder.db
DOCUMENT_STORAGE_PATH=../../storage/documents
API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_TELEMETRY_DISABLED=1
# Optional comma-separated exact domains. Leave empty until you have reviewed a source.
TRUSTED_SOURCE_DOMAINS=
